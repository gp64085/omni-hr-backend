# Application Settings
PROJECT_NAME="OmniHR Enterprise HRMS"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/omni_hr"
SQL_ECHO=false

# Redis Configuration (Caching & Session management)
REDIS_URL="redis://localhost:6379/0"

# Security & JWT Tokens
JWT_SECRET="super-secret-omni-hr-key-change-in-production-32-bytes"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-32-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Application & Password Reset
FRONTEND_URL="http://localhost:3000"
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# SMTP & Email Delivery Settings
# Leave SMTP_HOST empty in local dev to route reset emails to the console log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL="noreply@omnihr.internal"
EMAILS_FROM_NAME="OmniHR System"

# Background Accrual Scheduler
RUN_SCHEDULER=true

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
